.profile-page {
  padding-bottom: 132rpx;
}

.hero {
  padding: 36rpx 4rpx 28rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(32, 37, 34, 0.06);
}

.avatar {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  color: #fff;
  background: #1d4f42;
  font-size: 36rpx;
  font-weight: 700;
}

.identity-copy {
  margin-left: 22rpx;
}

.identity-name {
  margin-bottom: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.account-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
  color: #6c7972;
  font-size: 20rpx;
}

.copy-account {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  color: #1d4f42;
  background: #e8f0eb;
  font-weight: 700;
}

.profile-section-title {
  margin: 42rpx 4rpx 18rpx;
  color: #5a635e;
  font-size: 24rpx;
  font-weight: 700;
}

.profile-section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin: 42rpx 4rpx 18rpx;
}

.profile-section-title--inline {
  margin: 0;
}

.profile-section-help {
  margin-top: 8rpx;
  color: #8a928d;
  font-size: 21rpx;
  line-height: 1.5;
}

.add-friend-button {
  flex: none;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #1d4f42;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 66rpx;
}

.add-friend-button::after,
.friend-cancel-button::after,
.friend-save-button::after {
  border: 0;
}

.friend-form-card,
.friends-card,
.shared-card {
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(32, 37, 34, 0.06);
}

.friend-form-card {
  margin-bottom: 20rpx;
  padding: 26rpx;
}

.friend-form-title {
  margin-bottom: 18rpx;
  color: #17483c;
  font-size: 28rpx;
  font-weight: 700;
}

.friend-search-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.friend-input {
  box-sizing: border-box;
  width: 100%;
  height: 82rpx;
  margin-top: 14rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e3e5e1;
  border-radius: 16rpx;
  color: #202522;
  background: #fafaf8;
  font-size: 26rpx;
  line-height: 82rpx;
}

.friend-search-line .friend-input {
  margin-top: 0;
}

.friend-account-input {
  min-width: 0;
  flex: 1;
}

.friend-search-button {
  flex: none;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 16rpx;
  color: #fff;
  background: #5575a8;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 82rpx;
}

.friend-search-button::after {
  border: 0;
}

.friend-form-help {
  margin-top: 10rpx;
  color: #8a928d;
  font-size: 20rpx;
  line-height: 1.5;
}

.account-result {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  font-size: 21rpx;
  line-height: 1.5;
}

.account-result--found {
  color: #1d4f42;
  background: #eaf4ee;
}

.account-result--hint {
  color: #866c4b;
  background: #fff7e9;
}

.account-result--error {
  color: #9f3229;
  background: #fcedea;
}

.account-result-title {
  margin-bottom: 2rpx;
  font-weight: 700;
}

.friend-placeholder {
  color: #a0a7a3;
}

.friend-form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.friend-form-actions button {
  flex: 1;
  margin: 0;
  font-size: 24rpx;
  font-weight: 700;
}

.friend-cancel-button {
  color: #5f6d65;
  background: #edf1ed;
}

.friend-save-button {
  color: #fff;
  background: #1d4f42;
}

.friends-card {
  padding: 0 26rpx;
}

.friend-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  min-height: 112rpx;
  border-bottom: 2rpx solid #f0f1ee;
}

.friend-row:last-child {
  border-bottom: 0;
}

.friend-identity {
  display: flex;
  min-width: 0;
  align-items: center;
}

.friend-avatar {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  color: #fff;
  background: #8b6b4a;
  font-size: 28rpx;
  font-weight: 700;
}

.friend-name {
  margin-left: 16rpx;
  color: #202522;
  font-size: 27rpx;
  font-weight: 700;
}

.friend-account {
  margin: 4rpx 0 0 16rpx;
  color: #6c7972;
  font-size: 19rpx;
  letter-spacing: 0.5rpx;
}

.friend-note {
  overflow: hidden;
  max-width: 350rpx;
  margin: 6rpx 0 0 16rpx;
  color: #8a928d;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.friend-edit {
  margin: 8rpx 0 0 16rpx;
  color: #5575a8;
  font-size: 20rpx;
}

.friend-note-editor {
  margin: 8rpx 0 0 16rpx;
}

.friend-note-input {
  box-sizing: border-box;
  width: 320rpx;
  height: 58rpx;
  padding: 0 12rpx;
  border: 2rpx solid #d7e2dc;
  border-radius: 12rpx;
  color: #202522;
  background: #fafcf9;
  font-size: 21rpx;
  line-height: 58rpx;
}

.friend-note-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.friend-note-save {
  color: #1d4f42;
}

.friend-note-cancel {
  color: #8a928d;
}

.friend-row-right {
  display: flex;
  flex: none;
  align-items: center;
  gap: 14rpx;
}

.friend-shared-count {
  color: #1d4f42;
  font-size: 19rpx;
}

.friend-remove {
  color: #a27a68;
  font-size: 21rpx;
}

.friends-empty {
  padding: 30rpx 26rpx;
  border-radius: 24rpx;
  color: #8a928d;
  background: #f0f5f1;
  font-size: 22rpx;
  line-height: 1.6;
}

.shared-section .profile-section-title {
  margin-top: 36rpx;
}

.shared-card {
  padding: 0 26rpx;
}

.shared-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 100rpx;
  border-bottom: 2rpx solid #f0f1ee;
}

.shared-row:last-child {
  border-bottom: 0;
}

.shared-trip-title {
  font-size: 26rpx;
  font-weight: 700;
}

.shared-friend-label {
  margin-top: 6rpx;
  color: #8a928d;
  font-size: 21rpx;
}

.shared-total {
  flex: none;
  color: #a64f1c;
  font-size: 25rpx;
  font-weight: 700;
}

.settings-card {
  padding: 0 28rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(32, 37, 34, 0.06);
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  border-bottom: 2rpx solid #f0f1ee;
}

.setting-row:last-child {
  border-bottom: 0;
}

.setting-title {
  font-size: 28rpx;
  font-weight: 600;
}

.setting-help {
  margin-top: 6rpx;
  color: #8a928d;
  font-size: 21rpx;
}

.setting-status {
  color: #8b5115;
  font-size: 21rpx;
}

.profile-note {
  margin: 28rpx 8rpx 0;
  color: #8a928d;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}
