<view wx:if="{{trip}}" class="page-shell detail-page">
  <view class="trip-header">
    <text class="eyebrow">{{trip.statusLabel}}</text>
    <view class="page-title">{{trip.title}}</view>
    <view class="trip-meta">{{trip.destination}} · {{trip.startDate}}—{{trip.endDate}}</view>
  </view>

  <view class="expense-card">
    <view class="expense-header">
      <view>
        <view class="expense-eyebrow">TRIP EXPENSES</view>
        <view class="expense-title">机酒记账</view>
      </view>
      <view class="expense-total">{{expenseSummary.totalLabel}}</view>
    </view>
    <view class="expense-meta">
      <text wx:if="{{expenseSummary.hasCosts}}">已记录 {{expenseSummary.pricedItemCount}} 项价格</text>
      <text wx:else>识别截图会自动带入价格，也可在编辑行程中手动调整</text>
    </view>
    <view class="expense-actions">
      <button class="expense-toggle" bindtap="toggleExpenseDetails">{{showExpenseDetails ? '收起明细' : '查看明细'}}</button>
      <button class="aa-button" bindtap="startAaShare">一键 AA</button>
    </view>
    <view wx:if="{{showExpenseDetails}}" class="expense-breakdown">
      <view wx:if="{{expenseSummary.hasCosts}}" class="expense-chart-wrap">
        <canvas type="2d" canvas-id="expense-ring" id="expense-ring" class="expense-ring"></canvas>
        <view class="expense-legend">
          <view wx:for="{{expenseSummary.breakdown}}" wx:key="key" class="legend-row">
            <view class="legend-name-wrap">
              <view class="legend-dot" style="background-color: {{item.color}};"></view>
              <text class="legend-name">{{item.label}}</text>
              <text class="legend-percent">{{item.percentLabel}}</text>
            </view>
            <text class="legend-amount">{{item.amountLabel}}</text>
          </view>
        </view>
      </view>
      <view wx:for="{{expenseSummary.breakdown}}" wx:key="key" class="expense-row">
        <view><text class="expense-row-label">{{item.label}}</text><text class="expense-row-count">{{item.countLabel}}</text></view>
        <text class="expense-row-amount">{{item.amountLabel}}</text>
      </view>
      <view wx:if="{{!expenseSummary.breakdown.length}}" class="expense-empty">还没有已填写价格的行程。</view>
    </view>
    <view wx:if="{{aaShare}}" class="aa-share-panel">
      <view class="aa-share-title">行程与 AA 账单已共享</view>
      <view class="aa-share-friends">共享给：{{aaShare.friendNames}}</view>
      <view class="aa-share-total-row">
        <view><text class="aa-share-label">{{aaShare.peopleCount}} 人均摊</text><text class="aa-share-help">含你和已选择好友</text></view>
        <text class="aa-share-total">每人 {{aaShare.perPersonLabel}}</text>
      </view>
    </view>
  </view>

  <view class="section-heading">
    <view>
      <view class="section-title">全程安排</view>
      <view class="muted">按当地日期与时间排列</view>
    </view>
    <button class="add-item" bindtap="addItem">添加行程</button>
  </view>

  <view wx:if="{{items.length}}" class="timeline">
    <view wx:for="{{items}}" wx:key="id" class="timeline-row">
      <view class="time-column">
        <view class="item-date">{{item.date}}</view>
        <view class="item-time">{{item.timeLabel}}</view>
      </view>
      <view class="timeline-track">
        <view class="timeline-dot {{item.isWaitingToBook ? 'timeline-dot--waiting' : ''}}"></view>
        <view class="timeline-line"></view>
      </view>
      <view class="timeline-content">
        <view class="item-card" data-id="{{item.id}}" bindtap="editItem">
          <view class="item-topline">
            <text class="item-type">{{item.typeLabel}}</text>
            <text class="status-pill {{item.isWaitingToBook ? 'status-pill--waiting' : ''}}">{{item.bookingStatusLabel}}</text>
          </view>
          <view class="item-title">{{item.title}}</view>
          <view wx:if="{{item.locationStart && item.hasRoute}}" class="item-route">{{item.locationStart}} → {{item.locationEnd}}</view>
          <view wx:elif="{{item.locationStart}}" class="item-route">{{item.locationStart}}</view>
          <view wx:if="{{item.airlineName}}" class="item-detail item-airline">{{item.airlineName}}</view>
          <view wx:if="{{item.transportNo}}" class="item-detail">{{item.transportNo}}</view>
          <view wx:if="{{item.terminalLabel}}" class="item-detail">{{item.terminalLabel}}</view>
          <view wx:if="{{item.travelClassLabel}}" class="item-detail">舱位 / 席别：{{item.travelClassLabel}}</view>
          <view wx:if="{{item.hotelMetaLabel}}" class="item-detail">{{item.hotelMetaLabel}}</view>
          <view wx:if="{{item.durationLabel}}" class="item-detail">{{item.durationLabel}}</view>
          <view wx:if="{{item.priceLabel}}" class="item-price">{{item.priceLabel}}</view>
          <view wx:if="{{item.isWaitingToBook}}" class="booking-box">
            <view>预计开售：{{item.expectedSaleAt || '尚未填写'}}</view>
            <view wx:if="{{item.preferredSeatClass}}">期望席别：{{item.preferredSeatClass}}</view>
            <button class="ticketed-button" catchtap="markTicketed" data-id="{{item.id}}">标记已出票</button>
          </view>
          <view wx:if="{{item.driveToNextMinutes}}" class="route-card">
            <view class="route-icon">↗</view>
            <view>
              <view class="route-duration">前往下一项 · 驾车约 {{item.driveToNextMinutes}} 分钟</view>
              <view class="route-distance">手动填写，可点击本项行程修改</view>
            </view>
          </view>
        </view>
        <view wx:if="{{item.showTaxiAction}}" class="transfer-action" catchtap="addTaxiBetween" data-from-id="{{item.id}}" data-to-id="{{item.transferToId}}">
          <text class="transfer-action-title">＋ 添加打车行程</text>
          <text class="transfer-action-route">{{item.transferRouteLabel}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="empty-itinerary">
    <view class="empty-title">行程还是空的</view>
    <view class="muted">先加入一段交通或一家酒店。</view>
    <button class="primary-button" bindtap="addItem">添加第一项</button>
  </view>

  <view wx:if="{{showAaPicker}}" class="aa-mask" catchtap="closeAaPicker">
    <view class="aa-sheet" catchtap="stopAaPicker">
      <view class="aa-sheet-handle"></view>
      <view class="aa-sheet-title">选择 AA 好友</view>
      <view class="aa-sheet-help">选择后将共享本次旅行行程、分类账单和均摊金额。</view>
      <view class="aa-friend-list">
        <view wx:for="{{friends}}" wx:key="id" class="aa-friend-row" data-id="{{item.id}}" bindtap="toggleAaFriend">
          <view class="aa-friend-identity">
            <view class="aa-friend-avatar">{{item.avatarText}}</view>
            <text class="aa-friend-name">{{item.name}}</text>
          </view>
          <view class="aa-check {{item.selected ? 'aa-check--selected' : ''}}">{{item.selected ? '✓' : ''}}</view>
        </view>
      </view>
      <button class="aa-confirm-button" bindtap="confirmAaShare">共享账单</button>
      <button class="aa-cancel-button" bindtap="closeAaPicker">取消</button>
    </view>
  </view>
</view>
