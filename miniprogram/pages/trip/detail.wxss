.detail-page {
  padding-bottom: 80rpx;
}

.trip-header {
  padding: 34rpx 4rpx 52rpx;
}

.trip-meta {
  margin-top: 16rpx;
  color: #69736d;
}

.expense-card {
  margin: 0 0 42rpx;
  padding: 28rpx;
  border: 2rpx solid #dce9e3;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #edf5f0 0%, #f9f6ed 100%);
}

.expense-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.expense-eyebrow {
  color: #738079;
  font-size: 19rpx;
  letter-spacing: 2rpx;
}

.expense-title {
  margin-top: 8rpx;
  color: #17483c;
  font-size: 32rpx;
  font-weight: 700;
}

.expense-total {
  color: #17483c;
  font-size: 38rpx;
  font-weight: 700;
  white-space: nowrap;
}

.expense-meta {
  margin-top: 14rpx;
  color: #6e7c74;
  font-size: 22rpx;
  line-height: 1.5;
}

.expense-toggle {
  display: inline-block;
  margin: 20rpx 0 0;
  padding: 0 22rpx;
  border: 2rpx solid #b9d0c4;
  border-radius: 999rpx;
  color: #17483c;
  background: rgba(255, 255, 255, 0.65);
  font-size: 22rpx;
  line-height: 64rpx;
}

.expense-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.aa-button {
  display: inline-block;
  margin: 20rpx 0 0;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #b56a1b;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.aa-button::after {
  border: 0;
}

.expense-toggle::after {
  border: 0;
}

.expense-breakdown {
  margin-top: 20rpx;
  padding-top: 8rpx;
  border-top: 2rpx solid rgba(185, 208, 196, 0.7);
}

.expense-chart-wrap {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 8rpx 0 22rpx;
}

.expense-ring {
  width: 210rpx;
  height: 210rpx;
  flex: none;
}

.expense-legend {
  min-width: 0;
  flex: 1;
}

.legend-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  padding: 8rpx 0;
}

.legend-name-wrap {
  display: flex;
  min-width: 0;
  align-items: center;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  flex: none;
  margin-right: 10rpx;
  border-radius: 50%;
}

.legend-name {
  overflow: hidden;
  color: #29352f;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.legend-percent {
  margin-left: 8rpx;
  color: #78857e;
  font-size: 19rpx;
}

.legend-amount {
  flex: none;
  color: #17483c;
  font-size: 22rpx;
  font-weight: 700;
}

.expense-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  color: #29352f;
}

.expense-row-label {
  font-size: 25rpx;
  font-weight: 700;
}

.expense-row-count {
  margin-left: 12rpx;
  color: #78857e;
  font-size: 21rpx;
}

.expense-row-amount {
  color: #17483c;
  font-size: 26rpx;
  font-weight: 700;
}

.expense-empty {
  padding: 14rpx 0 4rpx;
  color: #78857e;
  font-size: 22rpx;
}

.aa-share-panel {
  margin-top: 22rpx;
  padding: 20rpx;
  border: 2rpx solid #ead7b9;
  border-radius: 20rpx;
  background: #fff8eb;
}

.aa-share-title {
  color: #8b5115;
  font-size: 24rpx;
  font-weight: 700;
}

.aa-share-friends {
  margin-top: 8rpx;
  color: #866c4b;
  font-size: 21rpx;
}

.aa-share-total-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f0dfc2;
}

.aa-share-label {
  display: block;
  color: #5f482e;
  font-size: 23rpx;
  font-weight: 700;
}

.aa-share-help {
  display: block;
  margin-top: 4rpx;
  color: #9b8668;
  font-size: 19rpx;
}

.aa-share-total {
  flex: none;
  color: #a64f1c;
  font-size: 27rpx;
  font-weight: 700;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
}

.add-item {
  margin: 0;
  color: #1d4f42;
  background: #e2ebe6;
  font-size: 24rpx;
  font-weight: 700;
}


.add-item::after,
.ticketed-button::after {
  border: 0;
}

.timeline-row {
  display: grid;
  grid-template-columns: 150rpx 34rpx 1fr;
  min-height: 210rpx;
}

.timeline-content {
  min-width: 0;
}

.time-column {
  padding-top: 8rpx;
  text-align: right;
}

.item-date {
  color: #7a827d;
  font-size: 20rpx;
}

.item-time {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.timeline-track {
  position: relative;
}

.timeline-dot {
  position: absolute;
  z-index: 2;
  top: 14rpx;
  left: 10rpx;
  width: 18rpx;
  height: 18rpx;
  border: 6rpx solid #dce9e3;
  border-radius: 50%;
  background: #1d4f42;
}

.timeline-dot--waiting {
  border-color: #f5dfbc;
  background: #b56a1b;
}

.timeline-line {
  position: absolute;
  top: 38rpx;
  bottom: -10rpx;
  left: 21rpx;
  width: 2rpx;
  background: #d9ddd9;
}

.item-card {
  margin: 0 0 24rpx 16rpx;
  padding: 28rpx;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 10rpx 34rpx rgba(32, 37, 34, 0.05);
}

.item-topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-type {
  color: #68716c;
  font-size: 22rpx;
}

.status-pill {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #1d4f42;
  background: #e4eee9;
  font-size: 20rpx;
  font-weight: 700;
}

.status-pill--waiting {
  color: #955613;
  background: #fff0d7;
}

.item-title {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.item-price {
  margin-top: 14rpx;
  color: #a64f1c;
  font-size: 27rpx;
  font-weight: 700;
}

.item-route,
.item-detail {
  margin-top: 10rpx;
  color: #67706b;
  font-size: 24rpx;
}

.item-airline {
  color: #1d4f42;
  font-weight: 700;
}

.booking-box {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  color: #7b4c19;
  background: #fff8eb;
  font-size: 22rpx;
  line-height: 1.8;
}

.route-card { display: flex; gap: 16rpx; margin-top: 22rpx; padding: 18rpx; border-radius: 18rpx; color: #17483c; background: #edf4f0; }
.route-icon { display: flex; width: 44rpx; height: 44rpx; flex: none; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: #1d4f42; }
.route-duration { font-size: 24rpx; font-weight: 700; }
.route-distance { margin-top: 6rpx; color: #67766f; font-size: 20rpx; line-height: 1.5; }

.transfer-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin: -8rpx 0 26rpx 16rpx;
  padding: 16rpx 20rpx;
  border: 2rpx dashed #b9d0c4;
  border-radius: 18rpx;
  color: #17483c;
  background: #f5faf7;
}

.transfer-action-title {
  flex: none;
  font-size: 23rpx;
  font-weight: 700;
}

.transfer-action-route {
  overflow: hidden;
  color: #738079;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ticketed-button {
  margin: 18rpx 0 0;
  color: #7b4c19;
  background: #f6dfbb;
  font-size: 22rpx;
  font-weight: 700;
}

.empty-itinerary {
  padding: 70rpx 40rpx;
  border-radius: 28rpx;
  text-align: center;
  background: #fff;
}

.empty-title {
  margin-bottom: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-itinerary button {
  margin-top: 30rpx;
}

.aa-mask {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(26, 34, 30, 0.42);
}

.aa-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 18rpx 32rpx 34rpx;
  border-radius: 30rpx 30rpx 0 0;
  background: #fff;
}

.aa-sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 20rpx;
  border-radius: 999rpx;
  background: #d6ddd8;
}

.aa-sheet-title {
  color: #202522;
  font-size: 32rpx;
  font-weight: 700;
}

.aa-sheet-help {
  margin-top: 8rpx;
  color: #78857e;
  font-size: 21rpx;
  line-height: 1.5;
}

.aa-friend-list {
  max-height: 420rpx;
  margin-top: 20rpx;
  overflow: auto;
}

.aa-friend-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 86rpx;
  border-bottom: 2rpx solid #f0f1ee;
}

.aa-friend-identity {
  display: flex;
  align-items: center;
}

.aa-friend-avatar {
  display: flex;
  width: 52rpx;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  color: #fff;
  background: #8b6b4a;
  font-size: 23rpx;
  font-weight: 700;
}

.aa-friend-name {
  margin-left: 14rpx;
  color: #29352f;
  font-size: 26rpx;
  font-weight: 600;
}

.aa-check {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #c7d2cc;
  border-radius: 50%;
  color: #fff;
  font-size: 27rpx;
}

.aa-check--selected {
  border-color: #1d4f42;
  background: #1d4f42;
}

.aa-confirm-button,
.aa-cancel-button {
  margin: 18rpx 0 0;
  font-size: 25rpx;
  font-weight: 700;
}

.aa-confirm-button {
  color: #fff;
  background: #1d4f42;
}

.aa-cancel-button {
  color: #66736c;
  background: #edf1ed;
}

.aa-confirm-button::after,
.aa-cancel-button::after {
  border: 0;
}
