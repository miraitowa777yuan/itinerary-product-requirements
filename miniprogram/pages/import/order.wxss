.import-page { padding-bottom: 80rpx; }
.intro { margin: 18rpx 0 34rpx; color: #68716c; line-height: 1.7; }
.upload-card, .result-card { padding: 30rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 12rpx 38rpx rgba(32, 37, 34, .05); }
.result-card { margin-top: 28rpx; }
.type-picker { margin-bottom: 24rpx; padding: 22rpx 24rpx; border-radius: 18rpx; color: #1d4f42; background: #e8f0ec; font-weight: 700; }
.order-preview { width: 100%; height: 440rpx; margin-bottom: 24rpx; border-radius: 20rpx; background: #f1f1ed; }
.upload-placeholder { display: flex; height: 260rpx; margin-bottom: 24rpx; flex-direction: column; align-items: center; justify-content: center; border: 2rpx dashed #bfc8c3; border-radius: 20rpx; color: #78817c; }
.upload-symbol { margin-bottom: 16rpx; color: #1d4f42; font-size: 64rpx; }
.secondary-button { margin-top: 16rpx; color: #1d4f42; background: #e8f0ec; }
.secondary-button::after { border: 0; }
.result-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 30rpx; }
.result-title { font-size: 32rpx; font-weight: 700; }
.recognized-pill { padding: 8rpx 16rpx; border-radius: 999rpx; color: #1d4f42; background: #e4eee9; font-size: 22rpx; }
.warning-box { margin-bottom: 26rpx; padding: 20rpx; border-radius: 16rpx; color: #8b5115; background: #fff5e4; font-size: 22rpx; line-height: 1.7; }
.date-row { display: flex; gap: 18rpx; }
.half { flex: 1; }
.field-static { padding: 22rpx 24rpx; border-radius: 16rpx; color: #4d5852; background: #f1f2ef; }
.waiting-switch { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28rpx; padding: 24rpx; border-radius: 20rpx; background: #fff5e4; }
.waiting-title { color: #8b5115; font-weight: 700; }
