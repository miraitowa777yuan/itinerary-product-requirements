<view class="page-shell import-page">
  <text class="eyebrow">SMART IMPORT</text>
  <view class="page-title">截图变成行程</view>
  <view class="intro">上传酒店、机票、火车票或城际巴士购票截图。识别结果会先让你确认，再加入时间线。</view>

  <view class="upload-card">
    <picker range="{{typeOptions}}" range-key="label" value="{{typeIndex}}" bindchange="updateHintType">
      <view class="type-picker">订单类型：{{typeOptions[typeIndex].label}}</view>
    </picker>
    <image wx:if="{{imagePath}}" class="order-preview" src="{{imagePath}}" mode="aspectFit" />
    <view wx:else class="upload-placeholder">
      <view class="upload-symbol">⌁</view>
      <view>支持相册截图或现场拍摄</view>
    </view>
    <button class="primary-button" loading="{{recognizing}}" bindtap="chooseImage">{{imagePath ? '换一张截图' : '选择订单截图'}}</button>
    <button wx:if="{{imagePath && !recognized}}" class="secondary-button" loading="{{recognizing}}" bindtap="analyze">重新识别</button>
  </view>

  <view wx:if="{{recognized}}" class="result-card">
    <view class="result-heading">
      <view>
        <view class="result-title">请确认识别结果</view>
        <view class="muted">识别完整度 {{confidence}}%</view>
      </view>
      <view class="recognized-pill">可编辑</view>
    </view>

    <view wx:if="{{warnings.length}}" class="warning-box">
      <view wx:for="{{warnings}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="field">
      <text class="field-label">识别类型</text>
      <view class="field-static">{{form.type === 'hotel' ? '酒店' : form.type === 'flight' ? '航班' : form.type === 'train' ? '高铁 / 火车' : '城际巴士'}}</view>
    </view>

    <block wx:if="{{form.type === 'hotel'}}">
      <view class="field"><text class="field-label">酒店城市</text><input class="field-input" value="{{form.city}}" data-field="city" bindinput="updateField" /></view>
      <view class="field"><text class="field-label">酒店名称 *</text><input class="field-input" value="{{form.title}}" data-field="title" bindinput="updateField" /></view>
      <view class="field"><text class="field-label">房型</text><input class="field-input" value="{{form.roomType}}" data-field="roomType" bindinput="updateField" /></view>
      <view class="date-row">
        <view class="field half"><text class="field-label">入住日期 *</text><picker mode="date" value="{{form.date}}" bindchange="updateDate"><view class="field-picker">{{form.date || '选择日期'}}</view></picker></view>
        <view class="field half"><text class="field-label">退房日期</text><picker mode="date" value="{{form.checkOutDate}}" bindchange="updateCheckOutDate"><view class="field-picker">{{form.checkOutDate || '选择日期'}}</view></picker></view>
      </view>
      <view class="field"><text class="field-label">酒店地址 / 地点</text><input class="field-input" value="{{form.locationStart}}" data-field="locationStart" bindinput="updateField" /></view>
    </block>

    <block wx:else>
      <view class="field"><text class="field-label">{{form.type === 'flight' ? '航班号' : form.type === 'train' ? '车次' : '班次'}}</text><input class="field-input" value="{{form.transportNo}}" data-field="transportNo" bindinput="updateField" /></view>
      <view class="field"><text class="field-label">出发地 / 站点 *</text><input class="field-input" value="{{form.locationStart}}" data-field="locationStart" bindinput="updateField" /></view>
      <view class="field"><text class="field-label">目的地 / 站点</text><input class="field-input" value="{{form.locationEnd}}" data-field="locationEnd" bindinput="updateField" /></view>
      <view class="field"><text class="field-label">日期 *</text><picker mode="date" value="{{form.date}}" bindchange="updateDate"><view class="field-picker">{{form.date || '选择日期'}}</view></picker></view>
      <view class="date-row">
        <view class="field half"><text class="field-label">出发时间</text><picker mode="time" value="{{form.startTime}}" bindchange="updateStartTime"><view class="field-picker">{{form.startTime || '选择'}}</view></picker></view>
        <view class="field half"><text class="field-label">到达时间</text><picker mode="time" value="{{form.endTime}}" bindchange="updateEndTime"><view class="field-picker">{{form.endTime || '选择'}}</view></picker></view>
      </view>
      <view wx:if="{{form.type === 'flight'}}" class="field"><text class="field-label">舱位</text><input class="field-input" value="{{form.cabinClass}}" data-field="cabinClass" bindinput="updateField" /></view>
      <view wx:if="{{form.type === 'train'}}" class="field"><text class="field-label">席别</text><input class="field-input" value="{{form.seatClass}}" data-field="seatClass" bindinput="updateField" /></view>
      <view wx:if="{{form.type === 'train'}}" class="waiting-switch">
        <view><view class="waiting-title">待抢票</view><view class="muted">关闭表示已经出票</view></view>
        <switch checked="{{form.bookingStatus === 'waiting_to_book'}}" color="#B56A1B" bindchange="updateTrainStatus" />
      </view>
    </block>

    <view class="field"><text class="field-label">备注</text><textarea class="field-textarea" value="{{form.notes}}" data-field="notes" bindinput="updateField" /></view>
    <button class="primary-button" bindtap="save">确认并加入行程</button>
  </view>
</view>
