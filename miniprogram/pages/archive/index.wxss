.archive-page {
  padding-bottom: 132rpx;
}

.hero {
  padding: 36rpx 4rpx 28rpx;
}

.trip-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.trip-card {
  padding: 34rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 14rpx 42rpx rgba(32, 37, 34, 0.06);
}

.trip-card__top {
  display: flex;
  justify-content: space-between;
  color: #6a746e;
  font-size: 22rpx;
}

.trip-status--past {
  color: #6f7772;
}

.trip-title {
  margin-top: 30rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.trip-destination {
  margin-top: 8rpx;
  color: #515a55;
}

.trip-date {
  margin-top: 32rpx;
  color: #8a6750;
  font-size: 24rpx;
}

.trip-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid #f0f1ee;
}

.trip-action {
  min-width: 112rpx;
  box-sizing: border-box;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
}

.trip-action--restore {
  color: #1d4f42;
  background: #e2ebe6;
}

.trip-action--delete {
  color: #9f3229;
  background: #f6dedb;
}

.empty-state {
  margin-top: 100rpx;
  padding: 54rpx 40rpx;
  border-radius: 32rpx;
  text-align: center;
  background: #fff;
}

.empty-title {
  margin-bottom: 12rpx;
  font-size: 36rpx;
  font-weight: 700;
}
