page {
  min-height: 100%;
  background: #f6f5f1;
  color: #202522;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

button {
  font-size: 28rpx;
}

.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
}

.eyebrow {
  color: #69736d;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.page-title {
  margin: 12rpx 0 8rpx;
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1.15;
}

.muted {
  color: #737b76;
}

.primary-button,
.secondary-button,
.danger-button {
  border-radius: 999rpx;
  font-weight: 600;
}

.primary-button {
  color: #fff;
  background: #1d4f42;
}

.secondary-button {
  color: #1d4f42;
  background: #e2ebe6;
}

.danger-button {
  color: #9f3229;
  background: #f6dedb;
}

.primary-button::after,
.secondary-button::after,
.danger-button::after {
  border: 0;
}

.form-card {
  margin-top: 28rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(32, 37, 34, 0.06);
}

.field {
  margin-bottom: 28rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #5a635e;
  font-size: 24rpx;
}

.field-input,
.field-picker,
.field-textarea {
  box-sizing: border-box;
  width: 100%;
  padding: 22rpx 24rpx;
  border: 2rpx solid #e3e5e1;
  border-radius: 18rpx;
  background: #fafaf8;
}

.field-textarea {
  min-height: 160rpx;
}

.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.form-actions button {
  flex: 1;
}

